{
  "name": "silver-wolf",
  "version": "0.1.0",
  "private": true,
  "description": "Silver Wolf — AI companion. Monorepo JavaScript (UI Vue JSX, backend Node).",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "server:dev": "npm run server:bundle && node out/server/main.js",
    "server:bundle": "esbuild apps/server-node/src/main.js --bundle --platform=node --format=esm --target=node20 --outfile=out/server/main.js",
    "dev": "npm run server:bundle && electron-vite --config apps/stage-tamagotchi/electron.vite.config.js dev",
    "dev:tamagotchi": "npm run server:bundle && electron-vite --config apps/stage-tamagotchi/electron.vite.config.js dev",
    "build": "npm run server:bundle && electron-vite --config apps/stage-tamagotchi/electron.vite.config.js build",
    "start": "node scripts/jalankan.js",
    "start:software": "node scripts/jalankan.js --sw-software",
    "build:win": "npm run build && electron-builder --win nsis",
    "voice:convert": "node packages/pipelines-audio/scripts/pth2onnx.js",
    "spike:rvc": "node packages/pipelines-audio/scripts/spike-rvc.js",
    "assets:verify": "node scripts/verify-assets.js",
    "ukur:latensi": "node scripts/ukur/ukur-p0.js",
    "ukur:tag": "node scripts/ukur/ukur-tag.js",
    "clean": "rimraf out apps/stage-tamagotchi/release node_modules",
    "turbo:build": "npm run build"
  },
  "dependencies": {
    "@aituber-onair/chat": "^0.61.0",
    "@aituber-onair/core": "^0.26.18",
    "@aituber-onair/kizuna": "^0.0.3",
    "@aituber-onair/voice": "^0.25.0",
    "@huggingface/transformers": "^4.3.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "onnxruntime-node": "^1.20.1",
    "onnxruntime-web": "^1.20.1",
    "pinia": "^2.3.0",
    "piper-tts-web": "^1.1.2",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "rvc-onnx-web": "^1.0.0",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.5",
    "unocss": "^0.65.4",
    "vite": "^6.0.7",
    "vite-plugin-static-copy": "^3.1.2"
  },
  "build": {
    "appId": "ai.silverwolf.companion",
    "productName": "Silver Wolf",
    "directories": {
      "output": "apps/stage-tamagotchi/release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/stage-tamagotchi/resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "out/server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "apps/stage-tamagotchi/resources/icon.ico",
      "artifactName": "Silver-Wolf-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Silver Wolf"
    }
  }
}
