# Salin jadi .env lalu sesuaikan jika diperlukan. .env tidak boleh ikut ke git.
VTUBER_PORT=8787

# Wujud: 'pet' = jendela melayang tanpa bingkai di desktop, tembus pandang, tanpa
# entri taskbar (bawaan -- inilah wujud "Vtuber 2D di layar"), 'browser' = Flask
# saja, peramban dibuka sendiri setelah server siap (klik kanan pada dia = chat).
# Keduanya menyajikan HALAMAN YANG SAMA. Bisa juga per jalan:
#   python main.py --browser / python main.py --pet
VTUBER_TAMPAK=pet

# ---- perilaku jendela pet ----
# "Tanpa jendela sama sekali" TIDAK BISA di mesin ini: menanam jendela ke lapisan
# desktop sudah dicoba dan gagal (lihat README.md, bagian "Mode pet" -> "Tanpa
# jendela sama sekali"). Kesan itu
# karena itu dikejar lewat PERILAKU -- dia minggir saat memang tidak muat, dan
# Master selalu punya jalan kembali lewat tray + hotkey.
#
# Kapan dia minggir:
#   tidak                = selalu tampil. Jangan dipakai bersama VTUBER_TAMPAK=pet:
#                          dia selalu di atas jendela lain, jadi jendela kerja yang
#                          dimaksimalkan tertutupiCharacter olehnya.
#   layar-penuh (bawaan) = hanya saat jendela depan menutupi SELURUH monitor,
#                          termasuk pita taskbar: video layar penuh, game.
#   maksimal             = juga saat jendela depan sekadar dimaksimalkan.
#                          HINDARI kalau kerja sehari-hari memakai jendela maksimal:
#                          karakternya hampir selalu sembunyi dan itu terasa rusak.
VTUBER_PET_SEMBUNYI=layar-penuh
# Ikon tray: Tampilkan / Sembunyikan / Keluar. Jangan dimatikan selama
# VTUBER_PET_SEMBUNYI bukan 'tidak' -- itu satu-satunya jalan memanggilnya kembali.
VTUBER_PET_TRAY=ya
# Hotkey global untuk membuka/menutup kotak obrolan. Kosong = mati.
# Bentuk: ctrl+shift+s (urutan penahan bebas, huruf/angka terakhir).
VTUBER_PET_HOTKEY=ctrl+shift+s

# =====================================================================
# OTAK PERCAKAPAN (LLM 100% OFFLINE)
# =====================================================================
# Provider:
#   local / llama_cpp = model GGUF offline di folder model/, dihitung di CPU (bawaan)
#   vulkan            = GGUF yang SAMA, dihitung GPU terintegrasi lewat llama-server
#                       (proses anak yang dikelola main.py sendiri)
#   ollama            = daemon Ollama lokal di http://127.0.0.1:11434
VTUBER_LLM_PROVIDER=local
VTUBER_LOCAL_MODEL_PATH=model/gemma-4-E4B-it-UD-Q4_K_XL.gguf
VTUBER_LOCAL_MODEL_THREADS=4
VTUBER_LOCAL_MODEL_CTX=8192
# Nama yang dilaporkan ke /v1/chat/completions. Kosong = turun dari nama berkas
# (tanpa ekstensi). Diteruskan juga ke llama-server lewat -a.
VTUBER_LOCAL_MODEL_ALIAS=gemma-4b
# Sampling bawaan server (klien hanya mengirim temperature + max_tokens).
VTUBER_LOCAL_MIN_P=0.05
VTUBER_LOCAL_TOP_P=0.95
# Mode berpikir llama-server (-rea). MiniCPM5 dan Qwen3 punya mode ini; kalau
# hidup, balasan diawali blok <think> sehingga pembaca tag emosi gagal (raut
# wajah tidak pernah berubah) dan <think> ikut tampil di chat. on|off|auto.
VTUBER_LOCAL_REASONING=off

# Jalur GPU terintegrasi (Iris Xe / Arc tanpa VRAM sendiri).
# Perlu llama-server.exe + DLL build Vulkan di bin/llama/
# Kalau binary belum ada, chat JATUH ke CPU dan banner mengatakannya -- bukan diam-diam.
# Lapis yang dititipkan ke GPU; 99 = semua.
VTUBER_VULKAN_NGL=99
# Flash attention. TANPA ini offload penuh justru kalah dari CPU di mesin ini.
VTUBER_VULKAN_FA=ya
# Simpan slot menganggur ke prompt cache -> persona panjang tidak dihitung ulang.
VTUBER_VULKAN_SLOT_DIAM=ya
# Panaskan saat boot: baca GGUF + kompilasi shader = 5-15 dtk, lebih baik di sini
# daripada di dalam kalimat pertama.
VTUBER_VULKAN_MUAT_BOOT=ya
VTUBER_VULKAN_PERANGKAT=Vulkan0
VTUBER_LLAMA_SERVER=bin/llama

# Opsi jika menggunakan Ollama:
VTUBER_OLLAMA_URL=http://127.0.0.1:11434
VTUBER_OLLAMA_MODEL=llama3.2:3b

# =====================================================================
# MIC LOKAL -- STT tanpa Web Speech API (yang itu mengunggah suara ke Google/MS)
# =====================================================================
# Perlu: pip install faster-whisper + folder model di assets/whisper/<nama>/
VTUBER_STT=ya
# base (74 MB, cepat) | small (244 MB) | medium
VTUBER_STT_MODEL=base
VTUBER_STT_MODEL_PATH=assets/whisper
VTUBER_STT_BAHASA=id
VTUBER_STT_KOMPUTASI=int8
# Jangan 4: llama-server juga meminta thread.
VTUBER_STT_THREADS=2
VTUBER_STT_BEAM=1
VTUBER_STT_MUAT_BOOT=tidak
VTUBER_STT_MAKS_DETIK=30

# =====================================================================
# SUARA LOKAL -- TTS bahasa Indonesia yang jalan tanpa internet & tanpa kuota
# =====================================================================
# Rantai engine offline: piper+rvc,piper
VTUBER_TTS_RANTAI=piper+rvc,piper
VTUBER_TTS_PER_KALIMAT=true
VTUBER_TTS_BATAS_DETIK=40
VTUBER_TTS_JEDA_RESEP=60

# Piper: TTS Indonesia offline (ONNX), jalan di CPU.
VTUBER_TTS_PIPER_MODEL=assets/piper/id_ID-news_tts-medium.onnx
VTUBER_TTS_PIPER_SUARA=id_ID-news_tts-medium
VTUBER_TTS_PIPER_VOLUME=100
VTUBER_TTS_PIPER_PANJANG=0.9
# Prosodi. Dua knob ini mengatur seberapa RATA suaranya, bukan seberapa tinggi:
#   NOISE   = variasi akustik/prosodi  (bawaan model 0,667)
#   NOISE_W = variasi panjang suku kata; ini yang membuat ritmenya tidak seperti
#             metronom (bawaan model 0,8)
# SUDAH DIUJI 29 Sep, dan hasilnya: TIDAK MENOLONG. Diukur dengan sebaran nada
# dalam semitone (var/ukur_prosodi.py, satu kalimat):
#     bawaan 0,667/0,8  -> IQR 2,36 st
#     ritme  0,667/1,3  -> IQR 2,31 st
#     nada   0,9  /0,8  -> IQR 1,79 st
#     keduanya 0,9/1,3  -> IQR 1,95 st
# Semuanya duduk di 1,8-2,4 semitone = rentang pembaca berita. Percakapan manusia
# biasa bergerak 4-8 semitone. Jadi kakunya sifat MODEL ini, bukan salah setelan --
# knob-nya cuma menambah getaran kecil. Jangan buang waktu menggeser-geser angka ini;
# kalau mau suara yang benar-benar bernyawa, engine-nya yang harus diganti.
VTUBER_TTS_PIPER_NOISE=0.667
VTUBER_TTS_PIPER_NOISE_W=0.8

# RVC: mengubah warna suara (checkpoint Silver Wolf JP).
# Bukan TTS -- ia butuh audio sumber, dan sumbernya keluaran Piper.
VTUBER_RVC=ya
VTUBER_RVC_FOLDER=assets/rvc
VTUBER_RVC_MODEL=SilverWolfJP
VTUBER_RVC_VERSI=v2
VTUBER_RVC_F0=rmvpe
# Nada dasar. Sumbernya suara berita PRIA, jadi harus dinaikkan; angka = semitone.
# Median F0 terukur di mesin ini (var/ukur_f0.py, 3 kalimat, 29 Sep):
#   +9 -> 223,8 Hz   +11 -> 246,9 Hz
#   +10 -> 233,7 Hz  +12 -> 260,1 Hz
# +12 ada di ujung terang (gadis anime ceria); Silver Wolf itu santai dan datar,
# jadi bawaannya +10. Ubah satu angka ini, muat ulang, dan bandingkan.
VTUBER_RVC_TRANSPOSE=10
VTUBER_RVC_PROTEKSI=0.33
VTUBER_RVC_PENCUCIAN=3
VTUBER_RVC_CAMPUR_RMS=0.8
# Seberapa banyak index retrieval dipakai (0..1). Ini tuas UTAMA kesamaan suara:
# 0 = index 169 MB milik checkpoint tidak dibaca sama sekali dan hasilnya RVC
# generik. Biayanya terukur 1,1 dtk + 165 MB RAM, sekali per kalimat.
VTUBER_RVC_INDEKS_LAJU=0.6
# Nama/path *.index kalau satu folder punya lebih dari satu. Kosong = yang pertama.
VTUBER_RVC_INDEKS=
VTUBER_RVC_RESAMPLE=0
VTUBER_RVC_MUAT_BOOT=ya
VTUBER_RVC_BATAS_ANTREAN=8

# Cache suara
VTUBER_TTS_CACHE=ya
VTUBER_TTS_CACHE_FOLDER=var/cache-suara
VTUBER_TTS_CACHE_MAKS_MB=250
VTUBER_TTS_METERIK=tidak

# Memori Obsidian
VTUBER_JEDA_FAKTA=8

# =====================================================================
# AVATAR -- semua wajah, pose, gerakan, dan ukuran gambar diatur di sini
# =====================================================================
# Cara pakai: sunting nilainya, muat ulang jendela (hotkey ctrl+shift+s untuk
# memanggil kotaknya). Sisi web membaca .env lewat suntikan window.__VTUBER_ENV__
# di server_py/statis.py, dan ETag halaman ikut berubah saat .env berubah.
# Cek apa yang benar-benar terpakai: lihat baris "siap -- N wajah, N pose, N
# gerakan" di judul status halaman mode browser.
#
# Sintaks resep:   Id=Nilai   dipisah spasi (atau koma), boleh negatif.
#                  Blend default Add = MENAMBAH di atas nilai bawaan parameter.
#                  Id=Nilai:Overwrite untuk menulis mentah, :Multiply untuk mengali.
#                  Id=Nilai:Blend:mati=Angka untuk parameter yang "mati" bukan
#                  berarti bawaan -- key9 (kacamata) lahir dalam keadaan 1/pakai,
#                  jadi matinya harus ditulis 0.
#                  Tulis "kosong" untuk ekspresi tanpa parameter (mis. netral).
# Nama kunci:     huruf besar jadi kecil, garis bawah jadi garis hubung.
#                  VITE_POSE_TANGAN_1  ->  pose "tangan-1"
# Kata setelah VITE_WAJAH_ / VITE_POSE_ / VITE_GERAK_ SELALU dianggap nama resep,
# jadi knob lain memakai awalan sendiri (VITE_EKSPRESI_DASAR, VITE_AWAL_POSE,
# VITE_KEADAAN_). Baris yang dihapus atau dikomentari kembali ke bawaan di
# web/konfigurasi.js -- bawaan itu sudah model silverwolf, bukan penyihir lama.
#
# ID yang dipakai silverwolf adalah sakelar artmesh key1..key17 hasil pemasangan
# (key2 pipi hati, key3 marah, key5 ><, key6 kaget, key7 mata bintang, key8 air
# mata, key9 kacamata, key11 ubah wujud, key13 jaket, key14..17 tangan), BUKAN
# lapisan Param59 model lama. Setiap resep menyalakan yang dia mau dan MEMADAMKAN
# tetangganya, karena model ini tidak saling-mematikan sendiri.
#
# Rentang parameter model ini TIDAK seragam (key 0..1, ParamEyeLOpen 0..1.4,
# rahang 0..1). Kalau ada nilai yang keluar rentangnya, halaman memberi tahu lewat
# status "N konfigurasi perlu dicek" -- bukan diam-diam menjepit.

# ---- ukuran gambar & ketajaman ----
# Berkas model3.json yang dirender.
VITE_MODEL_URL="/models/silverwolf/silverwolf.model3.json"

# Berapa piksel nyata yang digambar per 1 piksel CSS.
#   auto  = ikuti devicePixelRatio layar, termasuk saat zoom browser (paling tajam)
#   angka = paksa, misalnya 2 untuk super-sampling atau 1 untuk hemat
VITE_RENDER_SKALA="auto"

# Batas atas untuk mode auto. Zoom 300% di layar 125% berarti ~4x: itu tajam
# tapi mahal. Turunkan ke 2 (bawaan lama) kalau FPS terasa jatuh.
VITE_RENDER_SKALA_MAKS="8"

# Antialias WebGL. Matikan hanya untuk menghemat GPU.
VITE_RENDER_HALUS="true"

# Ukuran kotak avatar dalam CSS px -- ikut jejak kaki di layar, BUKAN jumlah
# pikselnya (itu tugas VITE_RENDER_SKALA). Boleh fungsi CSS: min(), calc(), vw/vh.
VITE_PANGGUNG_UKURAN="min(90vh, 100%)"
# Isi salah satu ini kalau kotaknya mau tidak persegi; kosong = ikut ukuran di atas.
VITE_PANGGUNG_LEBAR=
VITE_PANGGUNG_TINGGI=

# Bagian tinggi kotak yang boleh diisi karakter; 1 = penuh sampai ubun-ubun
# terpotong. Naikkan untuk membesar, turunkan untuk menjauh.
VITE_AVATAR_ZOOM="0.96"
# Posisi mendatar: 0 = tepi kiri, 0.5 = tengah, 1 = tepi kanan.
VITE_AVATAR_X="0.5"
# Jangkar vertikal: 1 = kaki menempel dasar, 0.5 = tengah badan di tengah, 0 = kepala di dasar.
VITE_AVATAR_JANGKAR="1"

# ---- gerakan hidup bawaan ----
VITE_KEDIP="true"
VITE_NAPAS="true"
# Kepala dan mata mengikuti kursor.
VITE_IKUTI_KURSOR="true"

# Atlas tekstur model (public/models/silverwolf/tekstur).
# Model ini punya 8192; ukuran itu sudah maksimum yang tersedia dari aslinya.
VITE_TEKSTUR="8192"

# ---- irama render: hemat GPU saat avatar tidak sedang dilihat ----
# Berhenti menggambar SAMA SEKALI saat tab pindah ke latar atau jendela
# diminimakan -- yang dihemat bukan angka FPS, tapi permintaan GPU-nya.
VITE_IRAMA_JEDA_SAAT_SEMBUNYI="true"
# Batas FPS saat jendela terlihat TETAPI tidak fokus (overlay selalu-di-depan,
# atau tertutup jendela lain). 0 = biarkan penuh seperti saat fokus.
VITE_IRAMA_FPS_SAAT_TAK_FOKUS="30"

# ---- mesin keadaan gerak (diam / bicara / tidur) ----
# Tanpa ini dia patung yang hanya bergerak saat tombol ditekan atau tag chat datang.
# hidup=tidak  = perilaku lama persis, mesinnya tidak dipasang sama sekali.
# Nama gerakan harus ada di daftar VITE_GERAK_ di bawah; "kosong" = tanpa isyarat.
#   GERAK_DIAM  isyarat badan sesekali saat tidak ada apa pun (bawaan siklus,
#               satu-satunya motion yang tidak mengubah wajah)
#   GERAK_BICARA satu isyarat di awal balasan. Bawaannya kosong karena tidak ada
#               motion "ngobrol" di model ini -- rahang sudah dari amplitudo audio.
#   GERAK_TIDUR motion berputar (ulang=true) setelah lama tidak ada aktivitas.
# Waktu dihitung dari frame yang benar-benar digambar, jadi jendela yang
# tersembunyi tidak membuatnya "ketiduran" saat dipanggil kembali.
VITE_KEADAAN="true"
VITE_KEADAAN_GERAK_DIAM="siklus"
VITE_KEADAAN_GERAK_BICARA="kosong"
VITE_KEADAAN_GERAK_TIDUR="tidur"
# Setiap berapa detik dia boleh melempar satu isyarat (dibuat acak 0.5..1.5x).
VITE_KEADAAN_JEDA_DETIK="45"
# Setelah berapa detik tanpa suara DAN tanpa klik/ketik dia masuk tidur.
VITE_KEADAAN_DETIK_TIDUR="180"

# ---- wajah (tag chat, satu wajah aktif pada satu waktu) ----
# Ekspresi saat halaman baru dibuka dan saat balasan tidak memakai tag.
VITE_EKSPRESI_DASAR="netral"
# Lama pudar antar wajah, dalam milidetik. Dipakai juga sebagai konstanta waktu
# melunaknya pose (LapisanPose), jadi 0 = topi muncul dengan sentakan.
VITE_PUDAR_WAJAH_MS="1000"

# Sembilan wajah yang boleh dipakai Silver Wolf; namanya = tag di persona.md.
VITE_WAJAH_NETRAL="kosong"
VITE_WAJAH_SENYUM="key5=1 key3=0 key6=0"
VITE_WAJAH_SEMANGAT="key7=1 key2=0 key4=0 key8=0"
VITE_WAJAH_KAGET="key6=1 key3=0 key5=0"
VITE_WAJAH_BINGUNG="key4=1 key2=0 key3=0 key7=0 key8=0"
VITE_WAJAH_LELAH="key10=1"
VITE_WAJAH_GODA="key2=1 key3=0 key4=0 key7=0 key8=0"
VITE_WAJAH_SEBAL="key3=1 key5=0 key6=0"
VITE_WAJAH_SEDIH="key8=1 key2=0 key4=0 key7=0"

# ---- pose & aksesoris (kanal [prop:nama], ditumpuk di atas wajah) ----
# [prop:kacamata] menyalakan, [prop:kacamata=mati] memadamkan, [prop:kosong]
# melepas SEMUA aksesoris sekaligus. Pose ditulis paling akhir setiap frame, jadi
# dia TETAP di atas wajah apa pun -- menekan "sedih" tidak menghilangkan jaket.
# Nama berpungkang angka (tangan-1..4) dihitung satu keluarga: hanya satu yang
# boleh nyala, karena model kehabisan tangan kalau dua posisi tangan bersamaan.
# Pose yang sudah menyala sejak jendela dibuka (nama dipisah spasi), misal:
#   VITE_AWAL_POSE="kacamata jaket"
VITE_AWAL_POSE=
VITE_POSE_KACAMATA="key9=1:Overwrite:mati=0"
VITE_POSE_JAKET="key13=1"
VITE_POSE_UBAH_WUJUD="key11=1"
VITE_POSE_TANGAN_1="key14=1 key15=0 key16=0 key17=0"
VITE_POSE_TANGAN_2="key16=1 key15=0 key17=0"
VITE_POSE_TANGAN_3="key17=1 key14=0 key15=0 key16=0"
VITE_POSE_TANGAN_4="key15=1 key14=0 key16=0 key17=0"
# Token berawalan `#` = NAMA ARTMESH, bukan parameter: dipaksa tidak tergambar
# selama posenya mati. Satu-satunya jalan menutup tanda air pembuat model, yang
# tidak punya parameter apa pun. Mati = tidak kelihatan (bawaan).
#   ArtMesh35 = coretan pink + telinga kucing di kepala (texture_00)
#   ArtMesh425 = cap merah 夕墨 di badan (texture_01)
VITE_POSE_TANDA_AIR="#ArtMesh35 #ArtMesh425"

# ---- gerakan (motion) ----
# grup   = nama grup di silverwolf.model3.json (model ini cuma punya "isyarat");
# berkas = path di DALAM folder model; sumber = nama berkas aslinya di folder
# mentah kalau berbeda; ulang = true untuk motion yang berputar terus.
# Ulang butuh motion yang memang loop-friendly: saat dia berhenti (digusur lewat
# [gerak:kosong] atau karena bangun dari tidur), semua parameter dibersihkan ke
# nilai bawaan, jadi tidak ada tangan/air mata yang tertinggal di tengah jalan.
VITE_GERAK_BERUBAH_1="grup=isyarat berkas=gerakan/berubah-1.motion3.json ulang=false"
VITE_GERAK_BERUBAH_2="grup=isyarat berkas=gerakan/berubah-2.motion3.json ulang=false"
VITE_GERAK_SIKLUS="grup=isyarat berkas=gerakan/siklus.motion3.json ulang=false"
VITE_GERAK_TIDUR="grup=isyarat berkas=gerakan/tidur.motion3.json ulang=true"
