<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SilverWolf.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SilverWolf.App"
    xmlns:views="using:SilverWolf.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Silver Wolf">

    <!--
      Jendela berbingkai standar, 1180x760, minimum 780x560, buram #080b12.
      Persis seperti BrowserWindow di Electron (tanpa frame:false / transparent /
      always-on-top — mode "desktop pet" tidak pernah terimplementasi di Electron pun).

      TODO(M10): MicaBackdrop diganti; Mica ramah tema light sedangkan aplikasi ini
      dipaku dark. Rencana: DesktopAcrylicBackdrop atau SolidColorBrush #080b12,
      lalu blur per-elemen lewat Windows.UI.Composition (lihat M10).
    -->

    <Grid x:Name="Shell" Background="#FF080B12">

        <!--
          Dua keadaan lebar, diganti oleh AdaptiveTrigger — pengganti media query CSS.
          CSS asli: grid-template-columns: minmax(380px, 44vw) 1fr
          XAML GridLength tidak punya minmax() -> <ColumnDefinition Width="44*" MinWidth="380" />

          Lebar  (>= 841): dua kolom 44* / 56*, Konsol di kolom 1.
          Sempit (<= 840): satu kolom, dua baris 42* / 58*, keduanya melebar penuh.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="UkuranJendela">
                <VisualState x:Name="Lebar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="841" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StageColumn.Width" Value="44*" />
                        <Setter Target="StageColumn.MinWidth" Value="380" />
                        <Setter Target="ConsoleColumn.Width" Value="56*" />
                        <Setter Target="StageRow.Height" Value="*" />
                        <Setter Target="ConsoleRow.Height" Value="Auto" />
                        <Setter Target="Stage.(Grid.Column)" Value="0" />
                        <Setter Target="Stage.(Grid.Row)" Value="0" />
                        <Setter Target="Stage.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="Konsol.(Grid.Column)" Value="1" />
                        <Setter Target="Konsol.(Grid.Row)" Value="0" />
                        <Setter Target="Konsol.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Sempit">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StageColumn.Width" Value="*" />
                        <Setter Target="StageColumn.MinWidth" Value="0" />
                        <Setter Target="ConsoleColumn.Width" Value="0" />
                        <Setter Target="StageRow.Height" Value="42*" />
                        <Setter Target="ConsoleRow.Height" Value="58*" />
                        <Setter Target="Stage.(Grid.Column)" Value="0" />
                        <Setter Target="Stage.(Grid.Row)" Value="0" />
                        <Setter Target="Stage.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="Konsol.(Grid.Column)" Value="0" />
                        <Setter Target="Konsol.(Grid.Row)" Value="1" />
                        <Setter Target="Konsol.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="StageColumn" Width="44*" MinWidth="380" />
            <ColumnDefinition x:Name="ConsoleColumn" Width="56*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="StageRow" Height="*" />
            <RowDefinition x:Name="ConsoleRow" Height="Auto" />
        </Grid.RowDefinitions>

        <views:StageView x:Name="Stage" Grid.Column="0" Grid.Row="0" />
        <views:ConsoleView x:Name="Konsol" Grid.Column="1" Grid.Row="0" />

    </Grid>
</Window>
