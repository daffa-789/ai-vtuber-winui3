<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SilverWolf.App.Views.ConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SilverWolf.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Panel kanan — port komponen Konsol.jsx.

      Urutannya sama dengan aplikasi lama:
        1. header (tombol NEURO-SAMA + tombol status)
        2. kartu HUD ikatan
        3. telemetri GPU / MEM / TTS
        4. DaftarPesan  -> MessageListView
        5. Komposer     -> ComposerView

      Tombol NEURO-SAMA memakai Content yang sudah berubah mengikuti
      AutonomousMode (bukan IsChecked dua-arah), supaya tidak bergantung pada
      konversi bool -> bool? milik ToggleButton.
    -->
    <Grid Background="#FF0E1420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. header -->
        <Grid Grid.Row="0" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Content="{Binding TeksNeuro}"
                Click="OnNeuroDiklik"
                FontSize="12"
                Padding="12,6,12,6" />

            <Button
                Grid.Column="2"
                Content="{Binding StatusTombol}"
                Command="{Binding SegarkanCommand}"
                FontSize="12"
                Padding="12,6,12,6" />
        </Grid>

        <!-- 2. kartu HUD ikatan -->
        <Border Grid.Row="1" Margin="12,0,12,8" Padding="12" CornerRadius="10" Background="#FF131A26">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding TeksIkatan}" FontSize="15" Foreground="#FFE2E8F0" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="🌸 Elus Kepala" Command="{Binding ElusKepalaCommand}" FontSize="12" />
                    <Button Content="⚡ Pancing Obrolan" Command="{Binding PancingObrolanCommand}" FontSize="12" />
                </StackPanel>

                <TextBlock Text="{Binding TeksXp}" FontSize="12" Foreground="#FF94A3B8" />
                <ProgressBar Value="{Binding Kemajuan}" Maximum="1" Height="6" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="12" Foreground="#FF94A3B8">
                        <Run Text="Kehangatan " />
                        <Run Text="{Binding TeksKehangatan}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" FontSize="12" Foreground="#FF94A3B8">
                        <Run Text="Atmosfer " />
                        <Run Text="{Binding TeksAtmosfer}" />
                        <Run Text=" | Sikap " />
                        <Run Text="{Binding TeksSikap}" />
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. telemetri -->
        <Border Grid.Row="2" Margin="12,0,12,8" Padding="10,6,10,6" CornerRadius="8" Background="#FF101724">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" Foreground="#FF64748B" TextTrimming="CharacterEllipsis">
                    <Run Text="GPU " />
                    <Run Text="{Binding TeksGpu}" />
                </TextBlock>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="#FF64748B" TextTrimming="CharacterEllipsis">
                    <Run Text="MEM " />
                    <Run Text="{Binding TeksMemori}" />
                </TextBlock>
                <TextBlock Grid.Column="2" FontSize="11" Foreground="#FF64748B">
                    <Run Text="TTS " />
                    <Run Text="{Binding TeksTts}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- 4. DaftarPesan -->
        <views:MessageListView Grid.Row="3" Margin="8,0,8,8" />

        <!-- 5. Komposer -->
        <views:ComposerView Grid.Row="4" Margin="12,0,12,12" />
    </Grid>
</UserControl>
