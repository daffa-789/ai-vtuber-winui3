<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SilverWolf.App.Views.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Riwayat percakapan — port komponen DaftarPesan.

      Isinya dibaca dari CompanionViewModel.Messages (ObservableCollection
      yang diubah saat balasan dialirkan), jadi tidak ada pengikatan ulang
      manual. Baris galat memakai TeksGalat yang sudah kosong bila tidak ada
      galat — tanpa konverter Visibility.

      Penanda loading (9 Okt): gelembung yang belum punya isi apa pun
      (menunggu token pertama LLM, atau menunggu suara RVC siap) menampilkan
      ProgressRing yang berputar. Visibilitas dikendalikan properti
      VisibilitasMemuat/VisibilitasKonten di ChatBubble, jadi tidak perlu
      konverter.

      Kenapa ProgressRing, bukan animasi titik buatan sendiri:
      ProgressRing adalah kontrol bawaan WinUI yang animasinya sudah benar,
      hemat, dan tidak perlu Storyboard + x:Name. Di dalam DataTemplate,
      x:Name tidak bisa ditarik dari Storyboard bersama (namescope berbeda),
      jadi Storyboard manual justru rapuh. ProgressRing bebas dari masalah itu.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,8"
                        Padding="10,8,10,8"
                        CornerRadius="8"
                        Background="#FF131A26">
                        <StackPanel Spacing="4">
                            <!-- NamaPeran, bukan Role: "assistant" bocor ke layar. -->
                            <TextBlock
                                Text="{Binding NamaPeran}"
                                FontSize="11"
                                Foreground="#FF64748B" />

                            <!-- Isi gelembung: disembunyikan selama loading. -->
                            <TextBlock
                                Text="{Binding Content}"
                                TextWrapping="Wrap"
                                FontSize="14"
                                Foreground="#FFE2E8F0"
                                Visibility="{Binding VisibilitasKonten}" />

                            <!-- Animasi loading. -->
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Padding="0,2,0,2"
                                Visibility="{Binding VisibilitasMemuat}">
                                <ProgressRing
                                    IsActive="{Binding SedangMemuat}"
                                    AutomationProperties.Name="Menyiapkan balasan"
                                    Width="16"
                                    Height="16"
                                    Foreground="#FF94A3B8" />
                                <TextBlock
                                    Text="{Binding TeksMemuat}"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="#FF94A3B8"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock
                                Text="{Binding CatatanSuara}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="#FF94A3B8" />

                            <TextBlock
                                Text="{Binding TeksGalat}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="#FFF87171" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
