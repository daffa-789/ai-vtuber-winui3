<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SilverWolf.App.Views.MessageListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Riwayat percakapan — port komponen DaftarPesan.

      Isinya dibaca dari CompanionViewModel.Messages (ObservableCollection
      yang diubah saat balasan dialirkan), jadi tidak ada pengikatan ulang
      manual. Baris galat memakai TeksGalat yang sudah kosong bila tidak ada
      galat — tanpa konverter Visibility.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,8"
                        Padding="10,8,10,8"
                        CornerRadius="8"
                        Background="#FF131A26">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{Binding Role}"
                                FontSize="11"
                                Foreground="#FF64748B" />
                            <TextBlock
                                Text="{Binding Content}"
                                TextWrapping="Wrap"
                                FontSize="14"
                                Foreground="#FFE2E8F0" />
                            <TextBlock
                                Text="{Binding TeksGalat}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="#FFF87171" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
