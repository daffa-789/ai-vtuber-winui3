<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SilverWolf.App.Views.StageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Panel kiri — port komponen/Panggung.jsx.

      SwapChainPanel SUDAH disediakan sekarang walau masih kosong, supaya M8
      (Cubism native, render D3D11) tinggal mengisinya tanpa menyusun ulang
      tata letak. Placeholder-nya hanya teks — bukan WebView2, bukan PixiJS,
      bukan Cubism Core Web (ketiganya dibuang bersama aplikasi lama).

      Tombol mirror tetap dipasang dan tetap menyimpan ke LocalSettings walau
      belum ada yang di-mirror: perilakunya menunggu M8, bukan M13.
    -->
    <Grid Background="#FF0B1018">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TODO(M8): isi panel ini dari SilverWolf.Live2D (C++/WinRT + Cubism). -->
        <!--
          JEBATAN YANG PERNAH TERJADI — jangan dikembalikan:

          SwapChainPanel di WinUI 3 **bukan** turunan Grid (beda dengan UWP),
          jadi ia TIDAK punya properti Background. Menulis
          Background="Transparent" langsung pada SwapChainPanel membuat XAML
          gagal diurai saat runtime (XamlParseException: "Setting 'Background'
          property is not supported on SwapChainPanel") dan aplikasi mati di
          MainWindow.InitializeComponent() — padahal build tetap hijau 0/0
          karena XAML diurai saat runtime, bukan saat kompilasi.

          Karena itu latar transparan diletakkan pada Grid pembungkus, yang
          sekaligus memegang penangan pointer. Latar itu WAJIB: tanpa latar,
          pembungkus tidak ikut uji tekan (hit test) dan PointerMoved tidak
          pernah menyala — fitur ikut kursor mati tanpa pesan apa pun.
        -->
        <Grid x:Name="PanggungLatar" Grid.Row="0" Background="Transparent"
              PointerMoved="OnPanggungPointerBergerak"
              PointerExited="OnPanggungPointerKeluar">
            <SwapChainPanel x:Name="PanggungPanel" />
        </Grid>

        <!--
          Placeholder. Disembunyikan oleh StageView.xaml.cs begitu renderer
          native benar-benar hidup — jadi kalau teks ini masih terlihat,
          berarti DLL belum ada atau gagal dimulai (lihat crash.log).
        -->
        <Border x:Name="Placeholder" Grid.Row="0" Margin="12" CornerRadius="10" Background="#33000000"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                Text="STAGE // Live2D — placeholder (M8)"
                Foreground="#FF94A3B8"
                FontSize="13"
                Margin="16,8,16,8" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,12" Spacing="8">
            <Button
                Content="{Binding TeksMirror}"
                Click="OnMirrorDiklik"
                FontSize="12"
                Padding="12,6,12,6" />
            <TextBlock
                Text="{Binding Expression}"
                Foreground="#FF64748B"
                FontSize="12"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
